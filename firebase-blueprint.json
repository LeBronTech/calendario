{
  "entities": {
    "Mission": {
      "title": "Mission",
      "description": "A scheduled lay ministry service or event organized by the user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "movement": { "type": "string" },
        "dateStr": { "type": "string" },
        "endDateStr": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "location": { "type": "string" },
        "description": { "type": "string" },
        "bannerUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["backlog", "preparing", "confirmed", "completed"] },
        "checklist": { "type": "array" },
        "musicMinister": { "type": "string" },
        "readers": { "type": "string" },
        "materialsNeeded": { "type": "array" },
        "googleEventId": { "type": "string" },
        "synced": { "type": "boolean" },
        "offlineSaved": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "instagramUrl": { "type": "string" },
        "instagramImgUrl": { "type": "string" },
        "movementLogoUrl": { "type": "string" },
        "tipo": { "type": "string" },
        "roles": { "type": "array" },
        "observation": { "type": "string" },
        "dailySchedules": { "type": "array" }
      },
      "required": ["id", "title", "movement", "status", "synced"]
    },
    "CatholicEvent": {
      "title": "CatholicEvent",
      "description": "General or customized Catholic events in the community.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "movement": { "type": "string" },
        "dateStr": { "type": "string" },
        "endDateStr": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "location": { "type": "string" },
        "description": { "type": "string" },
        "tipo": { "type": "string" },
        "city": { "type": "string" },
        "instagramUrl": { "type": "string" },
        "instagramImgUrl": { "type": "string" }
      },
      "required": ["id", "title", "movement", "tipo", "city"]
    }
  },
  "firestore": {
    "/users/{userId}/missions/{missionId}": {
      "schema": "Mission",
      "description": "The personal litugical missions/agenda created or customized by a user."
    },
    "/users/{userId}/catholicEvents/{eventId}": {
      "schema": "CatholicEvent",
      "description": "Customized general catholic events listed or customized by a user."
    }
  }
}
